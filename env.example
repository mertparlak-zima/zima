# zima machine/workspace configuration (copy to .env and adjust — .env is gitignored).
# This file holds NON-SECRET machine config only. zima.ps1 reads it via Read-ZimaEnv.
#
# SECRETS POLICY — read before editing:
#   TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID and GH_TOKEN live in the Windows USER environment
#   (HKCU), NOT here. Never write secret values into .env or any file; `zima verify -Full`
#   scans .env for secret-shaped values and fails the gate.

# GitHub org that owns the workspace repos (informational; repos.json is authoritative).
ZIMA_ORG=mertparlak-zima

# External roots used by workspace operations (machine-specific absolute paths).
ZIMA_DT_RUNNER_COMPOSE=D:\development\drive-trace\docker-runner
ZIMA_ANDROID_SDK=D:\development\drive-trace\android-sdk
ZIMA_DATASETS=D:\datasets

# Locale defaults for scripts that format output.
ZIMA_LOCALE=en-US
